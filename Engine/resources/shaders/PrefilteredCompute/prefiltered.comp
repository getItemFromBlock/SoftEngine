#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube u_EnvironmentMap;
layout(set = 0, binding = 1, rgba16f) uniform writeonly imageCube u_PrefilteredMap;

layout(push_constant) uniform PushConstants
{
    int   face;
    int   resolution;
    float roughness;
} pc;

const float PI = 3.14159265359;
const uint  SAMPLE_COUNT = 1024u;

vec3 GetFaceDir(int face, vec2 uv)
{
    switch (face)
    {
        case 0: return normalize(vec3( 1.0,  uv.y, -uv.x)); // +X
        case 1: return normalize(vec3(-1.0,  uv.y,  uv.x)); // -X
        case 2: return normalize(vec3( uv.x,  1.0, -uv.y)); // +Y
        case 3: return normalize(vec3( uv.x, -1.0,  uv.y)); // -Y
        case 4: return normalize(vec3( uv.x,  uv.y,  1.0)); // +Z
        case 5: return normalize(vec3(-uv.x,  uv.y, -1.0)); // -Z
    }
    return vec3(0.0);
}

float RadicalInverseVdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

vec2 Hammersley(uint i, uint N)
{
    return vec2(float(i) / float(N), RadicalInverseVdC(i));
}

vec3 ImportanceSampleGGX(vec2 xi, float roughness)
{
    float a = roughness * roughness;

    float phi      = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    return vec3(cos(phi) * sinTheta,
    sin(phi) * sinTheta,
    cosTheta);
}

mat3 BuildTBN(vec3 N)
{
    vec3 up    = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    vec3 fwd   = cross(N, right);
    return mat3(right, fwd, N);
}

float DGGX(float NdotH, float roughness)
{
    float a  = roughness * roughness;
    float a2 = a * a;
    float d  = (NdotH * NdotH) * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= pc.resolution || texel.y >= pc.resolution)
        return;
    vec2 uv = (vec2(texel) + 0.5) / float(pc.resolution) * 2.0 - 1.0;

    vec3 N = GetFaceDir(pc.face, uv);
    vec3 R = N;
    vec3 V = N;

    mat3 TBN = BuildTBN(N);

    vec3  prefilteredColor = vec3(0.0);
    float totalWeight      = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i)
    {
        vec2 xi = Hammersley(i, SAMPLE_COUNT);
        vec3 H  = TBN * ImportanceSampleGGX(xi, pc.roughness);
        vec3 L  = normalize(2.0 * dot(V, H) * H - V);         

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL <= 0.0)
            continue;

        float NdotH  = max(dot(N, H), 0.0);
        float HdotV  = max(dot(H, V), 0.0);
        float D      = DGGX(NdotH, max(pc.roughness, 0.001));
        float pdf    = (D * NdotH / (4.0 * HdotV)) + 0.0001;

        float saTexel  = 4.0 * PI / (6.0 * float(pc.resolution) * float(pc.resolution));
        float saSample = 1.0 / (float(SAMPLE_COUNT) * pdf + 0.0001);

        float mipBias  = 1.0;
        float mipLevel = pc.roughness == 0.0
        ? 0.0
        : mipBias + 0.5 * log2(saSample / saTexel);

        prefilteredColor += textureLod(u_EnvironmentMap, L, mipLevel).rgb * NdotL;
        totalWeight      += NdotL;
    }

    prefilteredColor /= totalWeight;

    imageStore(u_PrefilteredMap, ivec3(texel, pc.face), vec4(prefilteredColor, 1.0));
}