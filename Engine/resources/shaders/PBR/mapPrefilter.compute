#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform samplerCube envMap;

layout(binding = 1, rgba16f) uniform writeonly imageCube prefilterMap;

layout(push_constant) uniform PushConstants {
    int mipLevel;
    int mipCount;
    int face;
    int resolution;
} pc;

const float PI = 3.14159265359;

vec3 ImportanceSampleGGX(float u1, float u2, float roughness, vec3 N)
{
    float a = roughness * roughness;

    float phi = 2.0 * PI * u1;
    float cosTheta = sqrt((1.0 - u2) / (1.0 + (a*a - 1.0) * u2));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    vec3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;

    vec3 up = abs(N.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3 tangentX = normalize(cross(up, N));
    vec3 tangentY = cross(N, tangentX);

    return normalize(tangentX * H.x + tangentY * H.y + N * H.z);
}

vec3 TexelCoordToDir(ivec2 texel, int face, int size)
{
    float u = (float(texel.x) + 0.5) / float(size) * 2.0 - 1.0;
    float v = (float(texel.y) + 0.5) / float(size) * 2.0 - 1.0;

    if (face == 0) return normalize(vec3(1.0, -v, -u));
    if (face == 1) return normalize(vec3(-1.0, -v, u));
    if (face == 2) return normalize(vec3(u, 1.0, v));
    if (face == 3) return normalize(vec3(u, -1.0, -v));
    if (face == 4) return normalize(vec3(u, -v, 1.0));
    return normalize(vec3(-u, -v, -1.0));
}

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= pc.resolution || texel.y >= pc.resolution) return;

    vec3 N = TexelCoordToDir(texel, pc.face, pc.resolution);
    vec3 prefilteredColor = vec3(0.0);
    float totalWeight = 0.0;

    int SAMPLE_COUNT = 1024;
    float roughness = float(pc.mipLevel) / float(max(pc.mipCount-1, 1));

    for (int i = 0; i < SAMPLE_COUNT; ++i)
    {
        float u1 = float(i)/float(SAMPLE_COUNT);
        float u2 = fract(sin(float(i)*12.9898)*43758.5453);

        vec3 H = ImportanceSampleGGX(u1, u2, roughness, N);
        vec3 L = normalize(2.0*dot(N,H)*H - N);

        float NdotL = max(dot(N,L),0.0);
        if (NdotL > 0.0)
        {
            prefilteredColor += texture(envMap, L).rgb * NdotL;
            totalWeight += NdotL;
        }
    }

    prefilteredColor /= totalWeight;

    imageStore(prefilterMap, ivec3(texel, pc.face), vec4(prefilteredColor,1.0));
}